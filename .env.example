# ============================================
# GOOGLE OAUTH2
# ============================================
# Obtenha as credenciais em: https://console.cloud.google.com/
# 1. Crie um projeto
# 2. Ative a Google+ API
# 3. Crie credenciais OAuth 2.0
# 4. Configure URIs de redirecionamento:
#    - http://localhost:8000/accounts/google/login/callback/
#    - https://seu-dominio.com/accounts/google/login/callback/

GOOGLE_CLIENT_ID=seu-client-id-aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret-aqui

# ============================================
# DJANGO
# ============================================
# Gere uma SECRET_KEY forte em: https://djecrety.ir/
# Ou use: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'

SECRET_KEY=django-insecure-MUDE-ISSO-GERE-UMA-CHAVE-FORTE-AQUI
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# POSTGRESQL
# ============================================
# Configurações do banco de dados
# Para Docker: use DB_HOST=db
# Para local: use DB_HOST=localhost

DB_NAME=votacao_uems
DB_USER=postgres
DB_PASSWORD=sua-senha-do-postgres-aqui
DB_HOST=localhost
DB_PORT=5432

# ============================================
# E-MAIL (GMAIL SMTP)
# ============================================
# Para Gmail:
# 1. Ative a verificação em 2 etapas: https://myaccount.google.com/security
# 2. Gere uma senha de app: https://myaccount.google.com/apppasswords
#    - Selecione "E-mail" e "Outro (Sistema Votação UEMS)"
# 3. Use a senha de 16 caracteres gerada (sem espaços)

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-de-16-caracteres
DEFAULT_FROM_EMAIL=noreply@uems.br

# ============================================
# NOTAS IMPORTANTES
# ============================================
# - Este arquivo (.env.example) é apenas um template
# - Copie para .env e preencha com valores reais